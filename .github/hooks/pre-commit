#!/bin/bash
###############################################################################
# Pre-commit Hook - Language Validation
# Ensures all code and technical content is in English
###############################################################################

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🔍 Checking for non-English content in code files..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# File extensions to check
CODE_EXTENSIONS='\.sh$|\.js$|\.json$|\.conf$|\.service$|\.cfg$|\.yaml$|\.yml$'

# Filter for code files only
CODE_FILES=$(echo "$STAGED_FILES" | grep -E "$CODE_EXTENSIONS" || true)

if [ -z "$CODE_FILES" ]; then
    echo -e "${GREEN}✅ No code files to check${NC}"
    exit 0
fi

# Check for Swedish characters (å, ä, ö, Å, Ä, Ö)
SWEDISH_PATTERN='å|ä|ö|Å|Ä|Ö'

# Array to store files with issues
FAILED_FILES=()

# Check each code file
echo ""
for file in $CODE_FILES; do
    if [ -f "$file" ]; then
        if grep -q -E "$SWEDISH_PATTERN" "$file"; then
            FAILED_FILES+=("$file")
            echo -e "${RED}❌ Swedish characters found in: $file${NC}"
            # Show the lines with Swedish characters
            grep -n -E "$SWEDISH_PATTERN" "$file" | head -5
            echo ""
        fi
    fi
done

# Report results
if [ ${#FAILED_FILES[@]} -gt 0 ]; then
    echo ""
    echo -e "${RED}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${RED}❌ COMMIT REJECTED: Non-English content detected${NC}"
    echo -e "${RED}═══════════════════════════════════════════════════════════${NC}"
    echo ""
    echo "Files with issues:"
    printf '%s\n' "${FAILED_FILES[@]}"
    echo ""
    echo -e "${YELLOW}⚠️  CODING STANDARD VIOLATION${NC}"
    echo ""
    echo "All code, comments, and technical content MUST be in English."
    echo ""
    echo "Please fix the following:"
    echo "  • Replace Swedish characters in variable names"
    echo "  • Translate Swedish comments to English"
    echo "  • Use English for log/error messages"
    echo ""
    echo "See .github/CODING_STANDARDS.md for details"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ All code files are in English${NC}"
echo ""
exit 0
